{
  "name": "typehug-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep words together. Typography helpers for Polish and English.",
  "workspaces": [
    "packages/core",
    "packages/pl",
    "packages/en",
    "packages/all"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tests/types/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:packages": "node scripts/check-packages.mjs",
    "check": "npm run build && npm run typecheck && node --test tests/*.test.mjs && npm run test:packages",
    "example": "npm run build && node examples/basic.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "esbuild": "^0.28.2"
  },
  "license": "MIT"
}
